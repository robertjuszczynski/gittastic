{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/env.d.ts",
    "src/renderer/**/*",
    "src/renderer/**/*.tsx",
    "src/app/preload/*.d.ts",
    "src/shared/**/*"
, "src/main/utils/split-lanes.ts"  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@renderer/*": ["src/renderer/*"],
      "@shared": ["src/shared/index.ts"]
    }
  }
}
