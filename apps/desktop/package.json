{
  "name": "@gitastic/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "predev": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && npx steiger ./src/renderer && npx steiger ./src/onboarding/renderer",
    "dev": "electron-vite dev",
    "dev:reset-onboarding": "pnpm run predev && RESET_ONBOARDING=true electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "postinstall": "install-electron && npx @electron/rebuild -f -w node-pty"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@gitastic/types": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.42.2",
    "pino": "^10.3.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.2.7",
    "react-resizable": "^4.0.2",
    "react-router": "8.0.0",
    "rxjs": "^7.8.2",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "electron": "^43.1.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "node-pty": "^1.1.0",
    "steiger": "^0.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.63.0"
  }
}
