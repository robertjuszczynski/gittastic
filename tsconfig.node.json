{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["eslint.config.mts", "electron.vite.config.*", "src/app/main/**/*", "src/app/preload/**/*", "src/main/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node", "node"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@shared": ["src/shared/index.ts"],
      "@main/*": ["src/main/*"]
    }
  }
}
